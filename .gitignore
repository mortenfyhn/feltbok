# Build output
/build/
/app/build/
/.gradle/
/app/.cxx/
/.kotlin/

# Claude Code session/config dir
/.claude/
# Android SDK path — machine-specific
/local.properties

# LibreOffice/editor lock files
.~lock.*#

# Python
scripts/__pycache__/
# No trailing slash: also ignores a worktree's symlink (not just the dir) to the main venv.
.venv

# Official locality table + its source archive (built by build_localities.py)
/localities*.csv
/localities-raw*.json
/harvest.log
/raw-harvest.log
/add_footprints.log
/artsobs-dwca.zip
# Artsobservasjoner export/error spreadsheets (personal observation data)
/ExcelExport*.xlsx
# Generated species list (if regenerated locally)
/species.csv
# Locality import-matching test sheets
/lokalitetstest*.xlsx

# Leftover voice-era local files (never committed; safe to delete to reclaim space)
/recordings/
/models/
/observasjoner*.xlsx
/eksempel*.xlsx
/probe_*.xlsx
/my_localities.csv
/my-localities.csv

# Release signing - NEVER commit the keystore or its passwords (public repo).
*.keystore
*.jks
/keystore.properties
# Signed APK staged by release.sh for upload (deleted after, but ignore any leftover)
/feltbok-v*.apk
/localities_gazetteer.csv
/bird_species.csv
/localities-occurrences.jsonl
/mark_public.log
# Scratch import paste-tests (regenerate ad hoc; make_locality_test.py is the kept one)
/paste-test*.tsv
/verify.tsv
/scripts/localities-public-cache.json

*.sublime-workspace

# Composed store-image intermediates (regenerated by scripts/dev/store-assets/render.sh; art.svg is the source)
/scripts/dev/store-assets/icon.svg
/scripts/dev/store-assets/banner.svg
